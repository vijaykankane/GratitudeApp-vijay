
pipeline {
    agent any
    environment {
        AWS_REGION = 'eu-central-1'
       // TF_VAR_cluster_name = 'capstone-cluster'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'workingApp', url: 'https://github.com/vijaykankane/GratitudeApp-vijay.git'
            }
        }
        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }
        stage('Terraform Plan') {
            steps {
                dir('terraform') {

                    
                   //withCredentials([file(credentialsId: 'terraform-tfvars', variable: 'TFVARS_FILE')]) {
                         sh 'terraform plan '
                                //}
                }
            }
        }
        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve'
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}